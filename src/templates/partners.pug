---
title: Đối tác CD Restop
description: Đối tác chiến lược CD Restop gồm SPT Group, Coro Energy, DTH Holdings và Chao Holding — hợp tác phát triển hạ tầng an sinh và năng lượng xanh tại Việt Nam.
author: Giáp Thiện Phúc — Giám đốc Quan hệ Đầu tư, CD Restop Corporation
slug: partners.html
ogType: article
---
extends layouts/_layout
block content
	.page
		+sidebar('', '', 'active')
		.page__wrapper
			+header
			.page__center
				+users('Đội ngũ lãnh đạo CD Restop')
				.games
					.games__container
						.games__slider.js-slider.js-slider-view.js-slider-resize
							.games__slide
								+gamesItem('img/game-1.png', 'SPT Group', 'Đối tác Chiến lược Toàn diện')
							.games__slide
								+gamesItem('img/game-2.png', 'Coro Energy', 'Đối tác Chiến lược')
							.games__slide
								+gamesItem('img/game-3.png', 'DTH Holdings', 'Đối tác Hợp tác')
							.games__slide
								+gamesItem('img/game-4.png', 'Chao Holding', 'Đối tác Hợp tác')
				.player
					.player__title.h5 Đối tác chiến lược nổi bật
					.player__arrows
						button.player__arrow
							+i('arrow-prev')
						button.player__arrow
							+i('arrow-next')
					.player__wrapper
						.player__container
							.player__view(style="background-image: url('img/bg-player.png');")
								.player__counter Đang hợp tác
								button.player__toggle
									+i('play')
									+i('pause')
								.player__control
									.player__actions
										button.player__action
											+i('play')
											+i('pause')
										.player__volume
											button.player__action
												+i('sound-off')
												+i('sound-on')
											.player__line
												.player__progress(style="width: 75%;")
									.player__actions
										button.player__action
											+i('settings-fill')
										button.player__action
											+i('play-window')
										button.player__action
											+i('full-screen')
							.player__body
								.live.live_big Chiến lược
								.player__info.h4 SPT Group — Đối tác Chiến lược Toàn diện cấp Tập đoàn
								.player__parameters
									.player__parameter
										.player__icon
											img.player__pic(src="img/league-of-legends.png" alt="")
										.player__text Tập đoàn SPT
									.player__parameter 🇻🇳 Việt Nam
						.player__list
							.player__preview
								img.player__pic(src="img/player-pic-1.png" alt="")
							.player__preview
								img.player__pic(src="img/player-pic-2.png" alt="")
								.live Mới
							.player__preview.online
								img.player__pic(src="img/player-pic-3.png" alt="")
							.player__preview
								img.player__pic(src="img/player-pic-4.png" alt="")
							.player__preview
								img.player__pic(src="img/player-pic-1.png" alt="")
							.player__preview
								img.player__pic(src="img/player-pic-2.png" alt="")
								.live Mới
							.player__preview.online
								img.player__pic(src="img/player-pic-3.png" alt="")
							.player__preview
								img.player__pic(src="img/player-pic-4.png" alt="")
				.collection
					.collection__head
						.collection__title.h5 Tất cả đối tác
						.collection__field.field
							.field__wrap
								select.field__select
									option Tất cả
									option Chiến lược
									option Hợp tác
					.collection__list
						+card('img/card-pic-1.png', 'SPT Group — Đối tác Chiến lược Toàn diện cấp Tập đoàn', 'img/ava-1.png', 'confirm', 'SPT Group', 'Cấp Tập đoàn')
						+card('img/card-pic-2.png', 'Coro Energy — Đối tác Chiến lược năng lượng sạch', 'img/ava-2.png', 'confirm', 'Coro Energy', 'Năng lượng xanh')
						+card('img/card-pic-3.png', 'DTH Holdings — Đối tác Hợp tác phát triển hạ tầng', 'img/ava-3.png', 'confirm', 'DTH Holdings', 'Hạ tầng')
						+card('img/card-pic-4.png', 'Chao Holding — Đối tác Hợp tác thương mại quốc tế', 'img/ava-4.png', '', 'Chao Holding', 'Thương mại quốc tế')
				+categories('Hệ sinh thái CD Restop')
