include _mixins
doctype html
html(lang="en")
	head
		include _head

	body(class=bodyClass)
		//- check dark mode
		script.
			console.log(localStorage.getItem('darkMode'));
			if (localStorage.getItem('darkMode') === "on") {
					document.body.classList.add("dark");
					document.addEventListener("DOMContentLoaded", function() {
					  document.querySelector('.js-switch-theme input').checked = true;
					});
			}
			
		block content
		//- popup settings
		.popup.popup_settings.mfp-hide#popup-settings
			form.popup__form
				.popup__title.h6 Cài đặt tài khoản
				.popup__tags
					a.popup__tag.active(href="#") Hồ sơ
					a.popup__tag(href="#") Mật khẩu
					a.popup__tag(href="#") Email
					a.popup__tag(href="#") Thông báo
					a.popup__tag(href="#") Cài đặt
				.popup__field.field.mobile-show
					.field__wrap
						select.field__select
							option Hồ sơ cá nhân
							option Mật khẩu
							option Kênh
							option Ứng dụng
							option Xuất dữ liệu
				.popup__user
					.popup__title.h6.mobile-show Hồ sơ cá nhân
					.popup__category.caption-sm Ảnh đại diện
					.popup__line
						.popup__ava
							img.popup__pic(src="img/avatar.png" alt="")
						.popup__details
							.popup__btns
								.popup__loading
									input.popup__file(type="file")
									button.popup__btn.btn.btn_purple Tải ảnh lên
								button.popup__btn.btn.btn_gray Xoá ảnh
							.popup__text Ảnh đại diện giúp nhận diện tài khoản trong hệ thống CD Restop.
				.popup__fieldset
					.popup__row
						.popup__field.field
							.field__label Họ và tên
							.field__wrap
								input.field__input(type="text")
						.popup__field.field
							.field__label Tên hiển thị
							.field__wrap
								input.field__input(type="text")
					.popup__row
						.popup__field.field
							.field__label Chức vụ
							.field__wrap
								input.field__input(type="text")
						.popup__field.field
							.field__label Địa điểm
							.field__wrap
								input.field__input(type="text")
					.popup__row
						.popup__field.field
							.field__label Đơn vị
							.field__wrap
								input.field__input(type="text")
						.popup__field.field
							.field__label Nhóm
							.field__wrap
								input.field__input(type="text")
					.popup__field.field
						.field__label Giới thiệu
						.field__wrap
							textarea.field__textarea
				button.popup__btn.btn.btn_purple(type="submit") Cập nhật hồ sơ
		//- popup stories
		.popup.popup_stories.mfp-hide#popup-stories
			.stories
				.stories__container
					.stories__slider.js-slider-stories
						mixin slide
							.stories__slide
								.stories__item(style="background-image: url('img/stories-pic.png');")
									.stories__progress
										.stories__line.active
										.stories__line
									a.stories__user(href="#")
										.stories__ava
											img.stories__pic(src="img/ava-1.png" alt="")
										.stories__desc
											.stories__man.confirm Annie Nguyễn
											.stories__game Chủ tịch HĐQT
											.status.orange CD Restop
									form.stories__form
										input.stories__input(type="text" placeholder="Gửi tin nhắn…")
										button.stories__btn.btn.btn_purple Gửi
										button.stories__smile
											+i('editor-smile')
						+slide
						+slide
						+slide
						+slide
						+slide
						+slide
						+slide
						+slide
						+slide
						+slide
		include ./_scripts
