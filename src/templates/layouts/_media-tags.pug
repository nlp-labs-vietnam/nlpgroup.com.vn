//- Description no longer than 155 characters
meta(name="description" content=description || "NLP GROUP — Create Successful Life. Kiến tạo cuộc sống thành công qua giáo dục, huấn luyện và phát triển bản thân.")
meta(name="author" content=author || "NLP GROUP")
meta(name="robots" content="index, follow")
meta(name="theme-color" content="#6c5dd3")

//- Canonical URL
- var baseUrl = "https://nlp-labs-vietnam.github.io/nlpgroup.com.vn"
- var pageUrl = baseUrl + "/" + (slug || "")
link(rel="canonical" href=canonicalUrl || pageUrl)

//- Twitter Card
meta(name="twitter:card" content="summary_large_image")
meta(name="twitter:site" content="@nlpgroup")
meta(name="twitter:title" content=(title || "NLP GROUP") + " — NLP GROUP")
meta(name="twitter:description" content=description || "Create Successful Life — Kiến tạo cuộc sống thành công.")
meta(name="twitter:creator" content="@nlpgroup")
meta(name="twitter:image" content=ogImage || baseUrl + "/img/thumbnail.png")

//- Open Graph
meta(property="og:title" content=(title || "NLP GROUP") + " — NLP GROUP")
meta(property="og:type" content=ogType || "website")
meta(property="og:url" content=canonicalUrl || pageUrl)
meta(property="og:image" content=ogImage || baseUrl + "/img/thumbnail.png")
meta(property="og:image:width" content="297")
meta(property="og:image:height" content="256")
meta(property="og:description" content=description || "Create Successful Life — Kiến tạo cuộc sống thành công.")
meta(property="og:site_name" content="NLP GROUP")
meta(property="og:locale" content="vi_VN")
meta(property="article:author" content=author || "NLP GROUP")
meta(property="article:publisher" content="https://www.facebook.com/nlpgroup")
