						a.sidebar__item.js-popup-open(href="#popup-settings" data-effect="mfp-zoom-in")
							.sidebar__icon
								+i('settings')
							.sidebar__text Cài đặt
						a.sidebar__item(href="investors.html" class=item9)
							.sidebar__icon
								+i('chart')
							.sidebar__text Nhà đầu tư
						a.sidebar__item(href="nlp-group.html")
							.sidebar__icon
