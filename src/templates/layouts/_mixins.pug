mixin card(src, title, ava, classStatus, man, game)
	a.card(href="#")
		.card__preview
			img.card__pic(src=src)
		.card__body
			.card__title.h6=title
			.card__user
				.card__ava
					img.card__pic(src=ava alt="")
				.card__desc
					.card__man(class=classStatus)=man
					.card__game=game
		.card__foot
			.live Mới
			.status.blue Xem chi tiết

