mixin i(name)
	svg.icon(class='icon-' + name)
		use(xlink:href='img/sprite.svg#icon-' + name)

mixin sidebar(item1, item2, item3, item4, item5, item6, item7, item8, item9, classSidebar)
	.sidebar(class=classSidebar)
		.sidebar__top
			a.sidebar__logo(href="index.html")
				img.sidebar__pic.sidebar__pic_black(src="img/logo.png" alt="NLP GROUP")
				img.sidebar__pic.sidebar__pic_white(src="img/logo.png" alt="NLP GROUP")
			button.sidebar__burger
			button.sidebar__close
				+i('close')
		.sidebar__wrapper
			.sidebar__inner
				.sidebar__group
					.sidebar__caption.caption-sm <span>NLP </span>GROUP
					.sidebar__menu
						a.sidebar__item(href="index.html" class=item1)
							.sidebar__icon
								+i('game-play')
