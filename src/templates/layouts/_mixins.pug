mixin gamesItem(src, title, category, classItem)
	a.games__item(href="#" class=classItem)
		.games__preview
			img.games__pic(src=src)
		.games__details
			.games__title=title
			.games__category=category
			.status.orange Đang triển khai

mixin game(image, actions)
	.game
		.game__preview(style="background-image: url(" + image + ");")
			label.checkbox
				input.checkbox__input(type="checkbox")
				span.checkbox__in
					span.checkbox__tick
			.game__time Mới
			.game__line
				.game__progress(style="width: 65%;")
		.game__details
			.game__title CD Restop — Điểm dừng chân an sinh tại TP.HCM
			.game__status
				.status.blue 500 điểm định hướng
				.status.green Đang triển khai
			.game__name
				.game__logo
					img.game__pic(src="img/call-of-duty.png" alt="")
				.game__text CD Restop Corporation
			if actions
			else
				.game__actions
					button.game__action
						+i('eye')
					button.game__action
						+i('link')
					button.game__action
						+i('share')
					button.game__action
						+i('wand')
