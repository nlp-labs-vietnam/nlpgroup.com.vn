						a.sidebar__item(href="about.html" class=item2)
							.sidebar__icon
								+i('trending')
							.sidebar__text Giới thiệu
						a.sidebar__item(href="partners.html" class=item3)
							.sidebar__icon
								+i('profile')
							.sidebar__text Đối tác
						a.sidebar__item(href="ecosystem.html" class=item4)
							.sidebar__icon
								+i('camera')
							.sidebar__text Hệ sinh thái
							.sidebar__add
								+i('add')
						a.sidebar__item(href="news.html" class=item5)
							.sidebar__icon
								+i('document')
							.sidebar__text Tin tức
				.sidebar__group
					.sidebar__caption.caption-sm Đội ngũ lãnh đạo
					.sidebar__list
						a.sidebar__item(href="about.html" class=item6)
							.sidebar__ava
								img.sidebar__pic(src="img/ava-1.png" alt="")
							.sidebar__text Annie Nguyễn
						a.sidebar__item.online(href="about.html")
							.sidebar__ava
								img.sidebar__pic(src="img/ava-2.png" alt="")
							.sidebar__text Nguyễn Ngọc Hải
						a.sidebar__item(href="about.html")
							.sidebar__ava
								img.sidebar__pic(src="img/ava-3.png" alt="")
							.sidebar__text Hà Tuấn Khang
						a.sidebar__item(href="about.html")
							.sidebar__ava
								img.sidebar__pic(src="img/ava-4.png" alt="")
							.sidebar__text Đặng Thị Thuỳ Vân
						a.sidebar__item.online(href="about.html")
							.sidebar__ava
								img.sidebar__pic(src="img/ava-2.png" alt="")
							.sidebar__text Giáp Thiện Phúc
						a.sidebar__item(href="about.html")
							.sidebar__ava
								img.sidebar__pic(src="img/ava-5.png" alt="")
							.sidebar__text Nguyễn Hoàng Quốc Huy
						a.sidebar__item.online(href="about.html")
							.sidebar__ava
								img.sidebar__pic(src="img/ava-1.png" alt="")
							.sidebar__text Quản trị viên
					a.sidebar__more(href="about.html")
						.sidebar__arrow
							+i('arrow-down')
