---
title: Giới thiệu CD Restop
description: Công ty CP Đầu tư Hạ tầng An Sinh CD Restop — thành lập 2017, vốn 50 tỷ VNĐ, sứ mệnh kiến tạo hệ sinh thái điểm dừng chân chuẩn mực trên 34 tỉnh, thành.
author: Annie Nguyễn — Chủ tịch HĐQT, CD Restop Corporation
slug: about.html
ogType: article
---
extends layouts/_layout
block content
	.page
		+sidebar('', 'active')
		.page__wrapper
			+header
			.page__slider
				.page__info.h5 CD Restop Corporation
				.page__title.h2 Giới thiệu
				.main.main_trending.js-main
					.main__body
						.main__slider.js-slider.js-main-slider
							mixin slideBig(image, title, tag, sub)
								.main__slide
									.main__item(style="background-image: url(" + image + ");")
										.main__details
											.main__live.live.live_big #{tag}
											.main__title.h4 #{title}
											.main__parameters
												.main__parameter
													.main__icon
														img.main__pic(src="img/league-of-legends.png" alt="")
													.main__text #{sub}
												.main__parameter 🇻🇳 Việt Nam
											a.main__btn.btn.btn_purple(href="contact.html") Liên hệ hợp tác
							+slideBig('img/main-photo-1.png', 'Kiến tạo Hạ tầng An Sinh — Chuyển đổi số gặp chuyển đổi xanh', 'Sứ mệnh', 'CD Restop Corporation')
							+slideBig('img/main-photo-2.png', 'Mạng lưới 500 điểm dừng chân trên 34 tỉnh, thành Việt Nam', 'Tầm nhìn', '14.000 điểm sạc vệ tinh')
							+slideBig('img/main-photo-1.png', 'An sinh tự bền vững — Doanh thu thương mại nuôi các cấu phần an sinh', 'Cam kết', 'Không sử dụng ngân sách nhà nước')
							+slideBig('img/main-photo-2.png', 'Cúp Công nghệ Chiến lược 2026 · DAVAS 2026 · Net Zero 2050', 'Giải thưởng', 'Đổi mới sáng tạo')
					.main__foot
						.main__counter.js-main-counter
						.main__indicator Đang xem
							span.main__status.js-main-status
			.page__center
				.trending
					.trending__row
						.trending__col
							.trending__sorting
								.trending__field.field.mobile-show
									.field__wrap
										select.field__select.purple
											option Tất cả
											option Lãnh đạo
											option Sứ mệnh
								.trending__tags
									a.trending__tag.trending__tag_all(href='#') Tất cả
									a.trending__tag(href='#') Lãnh đạo
									a.trending__tag(href='#') Sứ mệnh
								.trending__field.field
									.field__wrap
										select.field__select
											option Mới nhất
											option 2026
							.trending__title.h6 Ban lãnh đạo CD Restop
							.trending__list
								mixin memberCard(number, classNumber, image, title, ava)
									.card
										.card__inner
											.card__bg(style="background-image: url(" + image + ");")
												.card__number(class=classNumber)=number
											.card__details
												.card__head
													.live Lãnh đạo
													.card__category CD Restop
												.card__title.h6=title
												.card__status
													.status.blue Đang hoạt động
													.status.green 2026
												.card__user
													.card__ava
														img.card__pic(src=ava alt="")
													.card__desc
														.card__man.confirm Annie Nguyễn
														.card__game Chủ tịch HĐQT
										.card__actions
											button.card__action
												+i('reply')
											button.card__action
												+i('play-square')
											button.card__action
												+i('heart')
								+memberCard('', 'card__number_crown', 'img/card-pic-1.png', 'Annie Nguyễn — Chủ tịch Hội đồng quản trị', 'img/ava-1.png')
								+memberCard('2', '', 'img/card-pic-2.png', 'Nguyễn Ngọc Hải — Tổng Giám đốc', 'img/ava-2.png')
								+memberCard('3', '', 'img/card-pic-3.png', 'Hà Tuấn Khang — Giám đốc Công nghệ & Marketing', 'img/ava-3.png')
								+memberCard('4', '', 'img/card-pic-4.png', 'Đặng Thị Thuỳ Vân — Giám đốc Tài chính', 'img/ava-4.png')
								+memberCard('5', '', 'img/card-pic-1.png', 'Giáp Thiện Phúc — Giám đốc Quan hệ Đầu tư', 'img/ava-1.png')
								+memberCard('6', '', 'img/card-pic-2.png', 'Nguyễn Hoàng Quốc Huy — Cố vấn Truyền thông', 'img/ava-2.png')
							.trending__btns
								button.trending__btn.btn.btn_gray Xem thêm
						.trending__col
							.trending__item.trending__item_streamers
								.trending__title.h6 Đội ngũ nổi bật
								.trending__group.js-slider-streamers.js-slider-resize
									.trending__slide
										a.trending__user(href="#")
											.trending__ava
												img.trending__pic(src="img/ava-1.png" alt="")
											.trending__desc
												.trending__man.confirm Annie Nguyễn
												.trending__game Chủ tịch HĐQT
												.status.orange Lãnh đạo cấp cao
									.trending__slide
										a.trending__user(href="#")
											.trending__ava
												img.trending__pic(src="img/ava-2.png" alt="")
											.trending__desc
												.trending__man Nguyễn Ngọc Hải
												.trending__game Tổng Giám đốc
												.status.orange CEO
									.trending__slide
										a.trending__user(href="#")
											.trending__ava
												img.trending__pic(src="img/ava-3.png" alt="")
											.trending__desc
												.trending__man Hà Tuấn Khang
												.trending__game GĐ Công nghệ
												.status.orange CTO
									.trending__slide
										a.trending__user(href="#")
											.trending__ava
												img.trending__pic(src="img/ava-4.png" alt="")
											.trending__desc
												.trending__man.confirm Đặng Thị Thuỳ Vân
												.trending__game GĐ Tài chính
												.status.orange CFO
									.trending__slide
										a.trending__user(href="#")
											.trending__ava
												img.trending__pic(src="img/ava-5.png" alt="")
											.trending__desc
												.trending__man.confirm Giáp Thiện Phúc
												.trending__game GĐ Quan hệ ĐT
												.status.orange CIR
								button.trending__btn.btn.btn_gray.btn_wide Liên hệ chúng tôi
							.trending__item
								.trending__title.h6 Thông tin pháp nhân
								.trending__slider.js-slider-games.js-slider-resize
									.trending__slide
										a.trending__box(href="#")
											.trending__preview
												img.trending__pic(src="img/game-pic-1.png" alt="")
											.trending__details
												.trending__game MST: 0314428519
												.trending__text Công ty CP Đầu tư Hạ tầng An Sinh CD RESTOP
									.trending__slide
										a.trending__box(href="#")
											.trending__preview
												img.trending__pic(src="img/game-pic-2.png" alt="")
											.trending__details
												.trending__game Thành lập: 26/05/2017
												.trending__text Vốn điều lệ: 50.000.000.000 VNĐ
									.trending__slide
										a.trending__box(href="#")
											.trending__preview
												img.trending__pic(src="img/game-pic-3.png" alt="")
											.trending__details
												.trending__game Trụ sở: TP.HCM
												.trending__text 54 Hồ Thị Tư, P. Tăng Nhơn Phú, TP.HCM
									.trending__slide
										a.trending__box(href="#")
											.trending__preview
												img.trending__pic(src="img/game-pic-4.png" alt="")
											.trending__details
												.trending__game Hotline: 0981 107 900
												.trending__text hi@cdrestop.com · 8:00–17:30 T2–T6
								button.trending__btn.btn.btn_gray.btn_wide Liên hệ ngay
